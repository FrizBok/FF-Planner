# Port, auf dem der Server lauscht
PORT=3000
# Interface (0.0.0.0 = alle Netzwerke, 127.0.0.1 = nur lokal, z. B. hinter Reverse-Proxy)
HOST=0.0.0.0
# Speicherort der Datenbank
DATA_DIR=./data
# Hinter Reverse-Proxy (Nginx Proxy Manager, Caddy …): true
TRUST_PROXY=false
# Secure-Cookies erzwingen (true) / abschalten (false). Leer = automatisch
COOKIE_SECURE=
TZ=Europe/Berlin
# Öffentliche Adresse (für Kalender-Abo-Links). Leer = aus der Anfrage (hinter Proxy TRUST_PROXY=true)
APP_URL=

# --- Portal „FrankenFinals Broadcast“ (Pflicht – Anmeldung läuft nur über das Portal)
# Adresse des Portals, z. B. https://portal.fl-tecmedia.de
PORTAL_URL=
# Gemeinsamer Schlüssel (mind. 32 Zeichen, openssl rand -hex 32) – im Portal identisch als PLANNER_SSO_SECRET
PORTAL_SSO_SECRET=
# Wie lange eine Anmeldung gilt (Stunden)
PORTAL_SESSION_HOURS=12
# Wie oft die Mitgliederliste aus dem Portal geholt wird (Minuten)
DIRECTORY_SYNC_MINUTES=10

# --- FF Rundown (optional)
# Adresse von FF Rundown – zeigt hinterlegte Rundowns als Link
RUNDOWN_URL=
# Schlüssel zum Auswählen/Anlegen von Rundowns (mind. 32 Zeichen) – in FF Rundown identisch als PLANNER_API_SECRET
RUNDOWN_API_SECRET=
